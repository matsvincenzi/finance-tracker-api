APP_NAME="Finance Tracker API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite); Docker Compose switches to MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3316
# DB_DATABASE=finance_tracker
# DB_USERNAME=finance
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Minutes until an API token expires (default: 7 days).
SANCTUM_TOKEN_EXPIRATION=10080

FRANKFURTER_URL=https://api.frankfurter.dev/v1
FRANKFURTER_TIMEOUT=5
